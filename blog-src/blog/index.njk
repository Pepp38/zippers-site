<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Blog · zippers.dev</title>
  <link rel="stylesheet" href="/blog/css/main.css">
</head>
<body>

<h1>Blog</h1>

<ul>
{% for post in collections.all | reverse %}
  {% if post.inputPath.includes('/blog/') and post.inputPath.endsWith('.md') %}
    <li>
      <a href="{{ post.url }}">{{ post.data.title }}</a>
         <small>{{ post.date }}</small>
    </li>
  {% endif %}
{% endfor %}
</ul>

</body>
</html>
